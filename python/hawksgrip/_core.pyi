"""Type stubs for the Rust extension module (crates/hawksgrip-py)."""

import numpy as np
import numpy.typing as npt

__version__: str
QUEEN: int
FIRST_SEVEN: int
SECTORS: list[str]
FIRST_THREAT: int
SEVEN: int

Event = tuple[int, str, int | None, tuple[float, float, float]]

class Session:
    def __init__(self, config_json: str | None = None, seed: int = 0) -> None: ...
    def step(self, n: int) -> int:
        """Advance n fixed ticks with the GIL released; returns the new tick."""
    @property
    def tick(self) -> int: ...
    @property
    def time(self) -> float: ...
    @property
    def dt(self) -> float: ...
    @property
    def tick_hz(self) -> int: ...
    @property
    def n_entities(self) -> int: ...
    @property
    def seed(self) -> int: ...
    def snapshot_into(self, pos: npt.NDArray[np.float64], vel: npt.NDArray[np.float64]) -> None: ...
    def positions(self) -> npt.NDArray[np.float64]: ...
    def velocities(self) -> npt.NDArray[np.float64]: ...
    def active_mask(self) -> npt.NDArray[np.bool_]: ...
    def roles(self) -> npt.NDArray[np.uint8]: ...
    def object_classes(self) -> npt.NDArray[np.int8]: ...
    def spawn_threat(self, pos: tuple[float, float, float], target: tuple[float, float, float], speed: float) -> None: ...
    def random_raid(self, count: int) -> None: ...
    def set_waypoint(self, entity: int, target: tuple[float, float, float], speed: float) -> None: ...
    def return_to_station(self, entity: int) -> None: ...
    def drain_events(self) -> list[Event]: ...
    def counters(self) -> dict[str, float]: ...
    def orbit_info(self) -> dict[str, object]: ...
    def state_hash(self) -> int: ...
    def export_replay(self) -> str: ...
    def config_json(self) -> str: ...
    def set_parallel(self, on: bool) -> None: ...
    def set_terrain(self, heights: npt.NDArray[np.float32], cell_m: float, origin_x: float, origin_y: float) -> None: ...
    def ground_height(self, x: float, y: float) -> float: ...
    # Phase 2: terrain, line-of-sight, refinery
    def terrain_heights(self) -> npt.NDArray[np.float32]: ...
    def terrain_info(self) -> dict[str, object]: ...
    def line_of_sight(self, a: tuple[float, float, float], b: tuple[float, float, float]) -> bool: ...
    def los_batch(self, a: npt.NDArray[np.float64], b: npt.NDArray[np.float64]) -> npt.NDArray[np.bool_]: ...
    def refinery_structures(self) -> list[dict[str, object]]: ...
    def keepout_distance(self, p: tuple[float, float, float]) -> float: ...
    def in_keepout(self, p: tuple[float, float, float]) -> bool: ...
    def path_clear_of_keepout(self, a: tuple[float, float, float], b: tuple[float, float, float]) -> bool: ...
    # Phase 3: Kindah's 24-eye compound optical array
    def spawn_birds(self, count: int) -> None: ...
    def set_visibility(self, visibility_m: float) -> None:
        """The [S] sandstorm key: ground-level visibility in metres (10..100000)."""
    def eyes(self) -> dict[str, npt.NDArray]: ...
    def tracks(self) -> list[dict[str, object]]: ...
    def timelines(self) -> list[dict[str, object]]: ...
    def sensor_counters(self) -> dict[str, int]: ...
    def sensor_info(self) -> dict[str, object]: ...
    def coverage_cpu(self, voxels: npt.NDArray[np.float64]) -> npt.NDArray[np.uint8]: ...
    def set_coverage_voxels(self, voxels: npt.NDArray[np.float64]) -> None: ...
    def coverage_resident(self) -> npt.NDArray[np.uint8]: ...
    def optics_params(self) -> dict[str, float]: ...

class PersonaEngine:
    """Kindah's voice ([T] toggles). Reads events only; never changes the simulation."""
    def __init__(self, seed: int = 0, tick_hz: int = 120, mode: str = "theatrical") -> None: ...
    @property
    def mode(self) -> str: ...
    def set_mode(self, mode: str) -> None: ...
    def toggle(self) -> str: ...
    def voice(self, session: Session, events: list[Event]) -> list[tuple[int, str, str, str]]: ...

def default_config_json() -> str: ...
def validate_config(config_json: str) -> str: ...
def verify_replay(replay_json: str) -> dict[str, object]: ...
def run_batch(
    seeds: list[int],
    ticks: int,
    raid: int,
    threads: int | None = None,
    config_json: str | None = None,
) -> list[tuple[int, int, int, int]]: ...
